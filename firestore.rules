rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'delapipen@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (
          isVerifiedUser()
          && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin'
        );
    }

    function isValidUserProgress(data) {
      return data.userId is string
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.learnerName is string
        && data.learnerName.size() >= 1
        && data.learnerName.size() <= 48
        && data.completedIslands is list
        && data.completedIslands.size() <= 35
        && (
          data.completedIslands.size() == 0
          || (
            data.completedIslands[0] is int
            && data.completedIslands[0] >= 1
            && data.completedIslands[0] <= 35
          )
        )
        && data.totalXp is number
        && data.totalXp >= 0
        && data.totalXp <= 50000
        && data.bestExamScore is number
        && data.bestExamScore >= -1
        && data.bestExamScore <= 20
        && data.passedExamsCount is int
        && data.passedExamsCount >= 0
        && data.passedExamsCount <= 500
        && data.speedrunsCompleted is int
        && data.speedrunsCompleted >= 0
        && data.speedrunsCompleted <= 1000
        && data.neutralizedAttacksCount is int
        && data.neutralizedAttacksCount >= 0
        && data.neutralizedAttacksCount <= 50
        && data.bestSpeedrunMs is int
        && data.bestSpeedrunMs >= 0
        && data.bestSpeedrunMs <= 3600000
        && data.selectedTrackId is string
        && data.selectedTrackId.size() <= 20
        && data.selectedTrackId in ['all', 'network', 'cloud-win', 'soc-cyber']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 48
        && data.totalXp is number
        && data.totalXp >= 0
        && data.totalXp <= 50000
        && data.completedIslandsCount is int
        && data.completedIslandsCount >= 0
        && data.completedIslandsCount <= 35
        && data.bestSpeedrunMs is int
        && data.bestSpeedrunMs >= 0
        && data.bestSpeedrunMs <= 3600000
        && data.bestSpeedrunCircuit is string
        && data.bestSpeedrunCircuit.size() <= 40
        && data.rankTitle is string
        && data.rankTitle.size() <= 56
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserRole(data, targetUserId) {
      return data.userId is string
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == targetUserId
        && data.role is string
        && data.role.size() <= 16
        && data.role in ['learner', 'instructor', 'admin']
        && data.assignedBy is string
        && data.assignedBy.size() <= 128
        && data.assignedBy.matches('^[a-zA-Z0-9_\\-]+$')
        && data.assignedBy == request.auth.uid
        && data.note is string
        && data.note.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProtectedAdminVault(data) {
      return data.policyName is string
        && data.policyName.size() >= 1
        && data.policyName.size() <= 80
        && data.minPassingScore is number
        && data.minPassingScore >= 10
        && data.minPassingScore <= 20
        && data.requireSignedTransfers is bool
        && data.strictZeroTrustMode is bool
        && data.updatedBy is string
        && data.updatedBy.size() <= 128
        && data.updatedBy.matches('^[a-zA-Z0-9_\\-]+$')
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecurityAuditLog(data) {
      return data.actorUid is string
        && data.actorUid.size() <= 128
        && data.actorUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.actorUid == request.auth.uid
        && data.action is string
        && data.action.size() >= 1
        && data.action.size() <= 64
        && data.targetId is string
        && data.targetId.size() >= 1
        && data.targetId.size() <= 128
        && data.outcome is string
        && data.outcome.size() <= 10
        && data.outcome in ['ALLOW', 'DENY']
        && data.createdAt is timestamp;
    }

    match /user_progress/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().keys().hasAll([
          'userId',
          'learnerName',
          'completedIslands',
          'totalXp',
          'bestExamScore',
          'passedExamsCount',
          'speedrunsCompleted',
          'neutralizedAttacksCount',
          'bestSpeedrunMs',
          'selectedTrackId',
          'createdAt',
          'updatedAt'
        ])
        && incoming().keys().hasOnly([
          'userId',
          'learnerName',
          'completedIslands',
          'totalXp',
          'bestExamScore',
          'passedExamsCount',
          'speedrunsCompleted',
          'neutralizedAttacksCount',
          'bestSpeedrunMs',
          'selectedTrackId',
          'createdAt',
          'updatedAt'
        ])
        && isValidUserProgress(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProgress(incoming())
        && (
          request.auth.uid == userId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'learnerName',
            'completedIslands',
            'totalXp',
            'bestExamScore',
            'passedExamsCount',
            'speedrunsCompleted',
            'neutralizedAttacksCount',
            'bestSpeedrunMs',
            'selectedTrackId',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /leaderboard/{userId} {
      allow get: if isValidId(userId) && (existing().isPublic == true || isOwner(userId) || isAdmin());
      allow list: if resource.data.isPublic == true && request.query.limit <= 50;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().keys().hasAll([
          'userId',
          'displayName',
          'totalXp',
          'completedIslandsCount',
          'bestSpeedrunMs',
          'bestSpeedrunCircuit',
          'rankTitle',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && incoming().keys().hasOnly([
          'userId',
          'displayName',
          'totalXp',
          'completedIslandsCount',
          'bestSpeedrunMs',
          'bestSpeedrunCircuit',
          'rankTitle',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && isValidLeaderboardEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidLeaderboardEntry(incoming())
        && (
          request.auth.uid == userId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'totalXp',
            'completedIslandsCount',
            'bestSpeedrunMs',
            'bestSpeedrunCircuit',
            'rankTitle',
            'isPublic',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // RBAC roles: readable by owner or verified admin; writable EXCLUSIVELY by verified admins
    match /roles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && incoming().keys().hasAll([
          'userId',
          'role',
          'assignedBy',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && incoming().keys().hasOnly([
          'userId',
          'role',
          'assignedBy',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && isValidUserRole(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserRole(incoming(), userId)
        && isAdmin()
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'role',
          'assignedBy',
          'note',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Protected admin-only vault: proves database rejects unauthorized SDK access even if UI is bypassed
    match /protected_admin_vault/{docId} {
      allow get: if isValidId(docId) && isAdmin();
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(docId)
        && incoming().keys().hasAll([
          'policyName',
          'minPassingScore',
          'requireSignedTransfers',
          'strictZeroTrustMode',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && incoming().keys().hasOnly([
          'policyName',
          'minPassingScore',
          'requireSignedTransfers',
          'strictZeroTrustMode',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && isValidProtectedAdminVault(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isVerifiedUser()
        && isValidId(docId)
        && isValidProtectedAdminVault(incoming())
        && isAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'policyName',
          'minPassingScore',
          'requireSignedTransfers',
          'strictZeroTrustMode',
          'updatedBy',
          'updatedAt'
        ]);

      allow delete: if isValidId(docId) && isAdmin();
    }

    // Append-only security audit journal: immutable once written, admin-only
    match /security_audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && incoming().keys().hasAll([
          'actorUid',
          'action',
          'targetId',
          'outcome',
          'createdAt'
        ])
        && incoming().keys().hasOnly([
          'actorUid',
          'action',
          'targetId',
          'outcome',
          'createdAt'
        ])
        && isValidSecurityAuditLog(incoming())
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if false;
      allow delete: if false;
    }
  }
}
